generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RecommendationFlat {
  inputId       String   @id @map("input_id")
  collection    String
  status        String?
  patternRef    String?  @map("pattern_ref")
  evaType       String?  @map("eva_type")
  platform      String?
  audience      String?
  title         String?
  how           String?
  why           String?
  recomendation Json?
  sources       Json?
  rawItem       Json?    @map("raw_item")
  insertedAt    DateTime @default(now()) @map("inserted_at")

  @@map("recommendation_flat")
}